{
  "expo": {
    "owner": "gilxsilva-2",
    "name": "gem",
    "slug": "gem",
    "scheme": "gem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f3ee"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cs278.spotmap",
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5f3ee"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.cs278.spotmap",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "be3469de-5c5b-447f-83f2-375447754435"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/be3469de-5c5b-447f-83f2-375447754435"
    }
  }
}
